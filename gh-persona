#!/usr/bin/env bash
set -euo pipefail

# gh-persona: Apply personas to Claude Code via git worktree + CLAUDE.md replacement
#
# Usage:
#   gh persona <domain/perspective>   - Activate a persona in a worktree
#   gh persona list                   - List available personas
#   gh persona clean [name]           - Remove worktree(s)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PERSONAS_DIR="${SCRIPT_DIR}/personas"
WORKTREE_BASE="${GH_PERSONA_WORKTREE_BASE:-/tmp/persona}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

print_usage() {
  cat <<EOF
Usage:
  gh persona <domain/perspective>   Activate a persona in a worktree
  gh persona list                   List available personas
  gh persona clean [name]           Remove worktree(s)

Examples:
  gh persona investor/macro         Activate investor/macro persona
  gh persona list                   Show all available personas
  gh persona clean investor-macro   Remove specific worktree
  gh persona clean                  Interactive cleanup
EOF
}

# List all available personas (domain/perspective combinations)
list_personas() {
  echo -e "${BOLD}Available personas:${NC}"
  echo ""

  for domain_dir in "${PERSONAS_DIR}"/*/; do
    [ -d "$domain_dir" ] || continue
    local domain
    domain=$(basename "$domain_dir")

    # Check if base.md exists
    if [ -f "${domain_dir}/base.md" ]; then
      echo -e "  ${CYAN}${domain}${NC}"

      # List perspectives
      if [ -d "${domain_dir}/perspectives" ]; then
        for perspective_file in "${domain_dir}/perspectives"/*.md; do
          [ -f "$perspective_file" ] || continue
          local perspective
          perspective=$(basename "$perspective_file" .md)
          echo -e "    ${GREEN}${domain}/${perspective}${NC}"
        done
      fi
      echo ""
    fi
  done
}

# Select persona interactively using fzf or numbered list
select_persona() {
  local personas=()

  for domain_dir in "${PERSONAS_DIR}"/*/; do
    [ -d "$domain_dir" ] || continue
    local domain
    domain=$(basename "$domain_dir")

    if [ -d "${domain_dir}/perspectives" ]; then
      for perspective_file in "${domain_dir}/perspectives"/*.md; do
        [ -f "$perspective_file" ] || continue
        local perspective
        perspective=$(basename "$perspective_file" .md)
        personas+=("${domain}/${perspective}")
      done
    fi
  done

  if [ ${#personas[@]} -eq 0 ]; then
    echo -e "${RED}No personas found in ${PERSONAS_DIR}${NC}" >&2
    exit 1
  fi

  # Try fzf first, fall back to numbered list
  if command -v fzf &>/dev/null; then
    printf '%s\n' "${personas[@]}" | fzf --prompt="Select persona: "
  else
    echo -e "${BOLD}Select a persona:${NC}" >&2
    local i=1
    for p in "${personas[@]}"; do
      echo -e "  ${i}) ${GREEN}${p}${NC}" >&2
      ((i++))
    done
    echo "" >&2
    read -rp "Enter number: " choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#personas[@]} ]; then
      echo "${personas[$((choice - 1))]}"
    else
      echo -e "${RED}Invalid selection${NC}" >&2
      exit 1
    fi
  fi
}

# Build CLAUDE.md by combining original + persona files
build_claude_md() {
  local git_root="$1"
  local worktree_path="$2"
  local domain="$3"
  local perspective="$4"

  local base_file="${PERSONAS_DIR}/${domain}/base.md"
  local perspective_file="${PERSONAS_DIR}/${domain}/perspectives/${perspective}.md"
  local knowledge_index="${PERSONAS_DIR}/${domain}/knowledge-index.md"
  local original_claude_md="${git_root}/CLAUDE.md"

  # Remove worktree's CLAUDE.md to prevent stale content
  rm -f "${worktree_path}/CLAUDE.md"

  # Start with original CLAUDE.md from the source repo (not worktree)
  local output=""
  if [ -f "$original_claude_md" ]; then
    output=$(cat "$original_claude_md")
    output="${output}"$'\n\n---\n\n'
  fi

  # Append persona base
  if [ -f "$base_file" ]; then
    output="${output}$(cat "$base_file")"$'\n\n'
  else
    echo -e "${RED}Base file not found: ${base_file}${NC}" >&2
    exit 1
  fi

  # Append perspective
  if [ -f "$perspective_file" ]; then
    output="${output}$(cat "$perspective_file")"$'\n\n'
  else
    echo -e "${RED}Perspective file not found: ${perspective_file}${NC}" >&2
    exit 1
  fi

  # Append knowledge index if exists
  if [ -f "$knowledge_index" ]; then
    output="${output}$(cat "$knowledge_index")"$'\n'
  fi

  echo "$output" > "${worktree_path}/CLAUDE.md"
}

# Activate a persona
activate_persona() {
  local persona="$1"
  local domain perspective

  # Parse domain/perspective
  domain=$(echo "$persona" | cut -d'/' -f1)
  perspective=$(echo "$persona" | cut -d'/' -f2)

  if [ -z "$domain" ] || [ -z "$perspective" ] || [ "$domain" = "$perspective" ]; then
    echo -e "${RED}Invalid persona format. Use: domain/perspective${NC}" >&2
    exit 1
  fi

  # Validate persona files exist
  if [ ! -f "${PERSONAS_DIR}/${domain}/base.md" ]; then
    echo -e "${RED}Domain '${domain}' not found${NC}" >&2
    exit 1
  fi
  if [ ! -f "${PERSONAS_DIR}/${domain}/perspectives/${perspective}.md" ]; then
    echo -e "${RED}Perspective '${perspective}' not found in domain '${domain}'${NC}" >&2
    exit 1
  fi

  # Check we're in a git repo and get the main repo root (not worktree)
  local git_root
  git_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo -e "${RED}Not in a git repository${NC}" >&2
    exit 1
  }

  # If running from inside a worktree, resolve to the main repo
  local common_dir
  common_dir=$(git rev-parse --git-common-dir 2>/dev/null)
  if [ -n "$common_dir" ] && [ "$common_dir" != ".git" ]; then
    # We're in a worktree; resolve main repo root from common git dir
    git_root=$(cd "$common_dir/.." && pwd)
  fi

  local worktree_name="${domain}-${perspective}"
  local worktree_path="${WORKTREE_BASE}-${worktree_name}"

  # Check if worktree already exists
  if [ -d "$worktree_path" ]; then
    echo -e "${YELLOW}Worktree already exists: ${worktree_path}${NC}"
    echo ""
    read -rp "Reuse existing worktree? [Y/n]: " reuse
    if [[ "$reuse" =~ ^[Nn] ]]; then
      echo "Removing existing worktree..."
      git worktree remove "$worktree_path" --force 2>/dev/null || rm -rf "$worktree_path"
      # Also remove the branch if it exists
      git branch -D "persona-${worktree_name}" 2>/dev/null || true
      echo "Creating new worktree..."
      git worktree add "$worktree_path" -b "persona-${worktree_name}" HEAD
    else
      echo "Reusing existing worktree."
    fi
  else
    echo "Creating worktree at ${worktree_path}..."
    git worktree add "$worktree_path" -b "persona-${worktree_name}" HEAD 2>/dev/null || \
      git worktree add "$worktree_path" "persona-${worktree_name}" 2>/dev/null || {
        # Branch might already exist from a previous session
        git branch -D "persona-${worktree_name}" 2>/dev/null || true
        git worktree add "$worktree_path" -b "persona-${worktree_name}" HEAD
      }
  fi

  # Always rebuild CLAUDE.md with latest persona
  echo "Building CLAUDE.md with persona: ${domain}/${perspective}..."
  build_claude_md "$git_root" "$worktree_path" "$domain" "$perspective"

  echo ""
  echo -e "${GREEN}${BOLD}Persona activated: ${domain}/${perspective}${NC}"
  echo -e "Worktree: ${CYAN}${worktree_path}${NC}"
  echo ""
  echo -e "To start Claude Code:"
  echo -e "  ${BOLD}cd ${worktree_path} && claude${NC}"
  echo ""

  # Output cd command for shell integration
  # Users can use: eval "$(gh persona investor/macro)"
  echo "cd ${worktree_path}"
}

# Clean up worktrees
clean_worktrees() {
  local target="$1"

  if [ -n "$target" ]; then
    # Clean specific worktree
    local worktree_path="${WORKTREE_BASE}-${target}"
    if [ -d "$worktree_path" ]; then
      echo "Removing worktree: ${worktree_path}..."
      git worktree remove "$worktree_path" --force 2>/dev/null || rm -rf "$worktree_path"
      git branch -D "persona-${target}" 2>/dev/null || true
      echo -e "${GREEN}Removed: ${target}${NC}"
    else
      echo -e "${RED}Worktree not found: ${worktree_path}${NC}" >&2
      exit 1
    fi
    return
  fi

  # Interactive cleanup: list all persona worktrees
  local worktrees=()
  while IFS= read -r line; do
    if [[ "$line" == *"${WORKTREE_BASE}-"* ]]; then
      worktrees+=("$line")
    fi
  done < <(git worktree list 2>/dev/null)

  if [ ${#worktrees[@]} -eq 0 ]; then
    echo "No persona worktrees found."
    return
  fi

  echo -e "${BOLD}Persona worktrees:${NC}"
  echo ""
  local i=1
  for wt in "${worktrees[@]}"; do
    echo -e "  ${i}) ${wt}"
    ((i++))
  done
  echo ""
  echo -e "  ${BOLD}a)${NC} Remove all"
  echo ""
  read -rp "Select to remove (number/a/q): " choice

  if [ "$choice" = "q" ]; then
    return
  elif [ "$choice" = "a" ]; then
    for wt in "${worktrees[@]}"; do
      local path
      path=$(echo "$wt" | awk '{print $1}')
      echo "Removing ${path}..."
      git worktree remove "$path" --force 2>/dev/null || rm -rf "$path"
    done
    echo -e "${GREEN}All persona worktrees removed.${NC}"
  elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#worktrees[@]} ]; then
    local path
    path=$(echo "${worktrees[$((choice - 1))]}" | awk '{print $1}')
    echo "Removing ${path}..."
    git worktree remove "$path" --force 2>/dev/null || rm -rf "$path"
    echo -e "${GREEN}Removed.${NC}"
  fi
}

# Main
case "${1:-}" in
  ""|"-h"|"--help")
    print_usage
    ;;
  "list")
    list_personas
    ;;
  "clean")
    clean_worktrees "${2:-}"
    ;;
  *)
    # If argument contains '/', treat as persona path
    if [[ "$1" == *"/"* ]]; then
      activate_persona "$1"
    else
      # Try interactive selection within the domain
      echo -e "${RED}Please specify persona as domain/perspective${NC}" >&2
      echo "" >&2
      list_personas
      exit 1
    fi
    ;;
esac
